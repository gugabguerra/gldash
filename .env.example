# Copy to `.env` — that file is gitignored, so values here stay off the repo.
#
#   cp .env.example .env

# Image reference used by docker-compose.yml. Leave unset to build and run
# locally as `gldash:latest`; point it at a registry to pull a prebuilt image.
#
#   GLDASH_IMAGE=registry.example.internal/gldash:latest
GLDASH_IMAGE=gldash:latest
